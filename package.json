{
  "name": "rhine-lab-analysis-os",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test scripts/check-music.mjs",
    "test:fixtures": "node scripts/create-music-fixtures.mjs",
    "typecheck": "tsc --noEmit",
    "build:performance": "tsc --noEmit && vite build --mode performance --outDir .cache/performance-review",
    "preview:performance": "vite preview --outDir .cache/performance-review --host 127.0.0.1 --port 4183 --strictPort",
    "postinstall": "node scripts/patch-rolling-number.mjs",
    "predev": "node scripts/patch-rolling-number.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/patch-rolling-number.mjs && node scripts/prepare-webfonts.mjs",
    "check:content": "node --experimental-strip-types --test scripts/check-content.mjs",
    "check:viewport": "node --experimental-strip-types scripts/check-viewport.mjs",
    "review:mobile": "node scripts/serve-mobile-review.mjs",
    "export:archives": "node scripts/export-records.mjs",
    "build": "tsc && vite build && node scripts/build-pwa.mjs",
    "build:desktop": "node scripts/patch-rolling-number.mjs && tsc --noEmit && vite build --mode desktop --outDir dist-desktop && node scripts/check-desktop-assets.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "build:cloudflare": "npm run build && node scripts/package-cloudflare.mjs",
    "build:wallpaper": "node scripts/patch-rolling-number.mjs && node scripts/export-records.mjs && tsc && vite build --mode wallpaper --outDir release/wallpaper && node scripts/build-wallpaper.mjs",
    "format": "prettier --write src scripts index.html package.json tsconfig.json",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@kitlangton/rolling-number": "0.4.1",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-http": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "music-metadata": "12.0.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/three": "^0.183.0",
    "fake-indexeddb": "6.2.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
